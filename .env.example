# The ONE place your production domain lives.
# Canonical URLs, Open Graph, sitemap.xml, robots.txt and JSON-LD all read this value.
# No trailing slash. Leave unset locally: the site falls back to http://localhost:3000
# and marks itself noindex so a preview can never be indexed with the wrong URLs.
NEXT_PUBLIC_SITE_URL=https://your-final-domain.com

# Optional: the content value of the Google Search Console HTML-tag verification.
# (Search Console > Add property > URL prefix > HTML tag > copy only the content="..." value)
GOOGLE_SITE_VERIFICATION=
